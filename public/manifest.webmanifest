{
  "name": "ViralRadar",
  "short_name": "ViralRadar",
  "description": "Ideas, scripts and results from Shorts Studio, plus a daily radar of trending short videos and tech links.",
  "start_url": "/#/radar",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#111111",
  "theme_color": "#2a78d6",
  "lang": "en-IN",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Radar", "url": "/#/radar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Projects", "url": "/#/projects", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Import", "url": "/#/import", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "file", "accept": ["image/*", "text/plain", ".txt", ".md", ".srt", ".json"] }
      ]
    }
  }
}
