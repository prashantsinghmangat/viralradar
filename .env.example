# Copy this file to .env and fill in what you need.

# Free YouTube Data API v3 key (see README). Leave empty to skip YouTube in the radar.
YOUTUBE_API_KEY=

# Folder to watch for viralradar-*.json exports. Leave empty for your Downloads folder.
# Windows example: WATCH_DIR=C:\Users\you\Downloads
WATCH_DIR=

# Port for the web app (open http://<laptop-ip>:PORT on your phone)
PORT=3000

# Optional: GitHub personal access token (no scopes needed) for higher GitHub rate limits
GITHUB_TOKEN=


# ----------------------------------------------------------------------------
# Cloud version (Supabase). Only needed on this laptop, never in the browser.
# ----------------------------------------------------------------------------

# Used by "npm run test:rls" to check that users cannot read each other's data.
#
# Take this from the Supabase dashboard:
#   Project Settings -> Database -> Connection string -> *** Session pooler ***
# then paste your database password into it.
#
# Use the SESSION POOLER string, not "Direct connection": the direct one is
# IPv6-only and usually will not work from a home network.
#
#   DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# This file is gitignored, so the password stays on this laptop.
DATABASE_URL=

# Your project's API address and its PUBLISHABLE key (older projects label it
# "anon public"). Both from Project Settings -> API Keys.
#
# These two are safe in a browser, which is the whole point: Row Level Security
# is what protects the data. NEVER put the secret / service_role key here.
#
# Only used by "npm run inspect:db", to check the one setting the CLI cannot
# see: whether the viralradar schema is exposed to the Data API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# AI keys (optional here)
# ----------------------------------------------------------------------------
#
# The deployed app reads these from Supabase secrets, NOT from this file:
#   npx supabase secrets set GEMINI_API_KEY=...
#
# Putting them here as well is optional, and only so the tests can call the
# real providers instead of a stand-in. Without them those tests still run,
# against a mock, and say so.
#
# Gemini:     https://aistudio.google.com/apikey
# OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
OPENROUTER_API_KEY=
